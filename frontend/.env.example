# Where the Openkit API lives. Must be reachable from the visitor's browser.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
# Only set if the WebSocket lives somewhere else. Defaults to the URL above with ws://.
# NEXT_PUBLIC_BACKEND_WS_URL=wss://api.example.com
# Sites allowed to embed this app in an iframe, space separated.
# EMBED_ORIGINS=https://rothenhall.com https://www.rothenhall.com
