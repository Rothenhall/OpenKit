# Copy to .env. Never commit the real file.
PORT=4000
SARVAM_API_KEY=

# Browser origins allowed to call the API and open the voice socket, comma separated.
# In development any localhost port is also allowed.
FRONTEND_ORIGIN=https://rothenhall.com,https://www.rothenhall.com

# Set to true (or a hop count) behind a reverse proxy or load balancer, so rate
# limits see the visitor and not the proxy.
TRUST_PROXY=true
NODE_ENV=production

# Postgres (Neon). Holds leads and, on serverless hosting, the live sessions so any server
# instance can resume a call. Without it the tool still runs, from memory, but the email
# form cannot save leads. Tables are created on first use.
DATABASE_URL=
# Gmail SMTP for the emailed PDF report. SMTP_PASSWORD is a Google app password for
# SMTP_USER (Google account, 2 step verification on, then Security, App passwords).
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# Gmail only sends as the account itself or a verified alias of it.
# MAIL_FROM=Rothenhall <reports@rothenhall.com>
# MAIL_REPLY_TO=
# A copy of every report, for the team.
# MAIL_BCC=

# Optional: ping the team on each new lead. Slack incoming webhook format, plain JSON for Zapier or Make.
# LEAD_WEBHOOK_URL=

# Cost and abuse ceilings. These are the defaults.
# GLOBAL_CALLS_PER_HOUR=300
# GLOBAL_ANALYSES_PER_HOUR=200
# MAX_LIVE_CALLS=100
# MAX_LIVE_CALLS_PER_IP=3

# Optional: pin one Sarvam voice for every call, by saved voice name.
# SARVAM_AGENT_VOICE=
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
# SARVAM_TASK_MODEL=glm5.3
